#!/bin/bash
# ============================================================================
# AuthFlow Installation Environment Template
# ============================================================================
# Copy this file and fill in your values:
#   cp .env.template .env.production
#   vi .env.production
#   source .env.production
#   sudo -E ./scripts/install-prod.sh
# ============================================================================

# Your primary domain (required)
# Example: example.com
export DOMAIN="example.com"

# Your VPS public IPv4 address (required)
# Example: 203.0.113.42
export VPS_IP="203.0.113.42"

# Cloudflare API Token (required)
# Get from: https://dash.cloudflare.com/profile/api-tokens
# Must have permissions: Zone:DNS:Edit, Zone:Zone:Read
# Example: cfut_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export CLOUDFLARE_TOKEN="cfut_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Telegram Bot Token (required)
# Get from: @BotFather on Telegram
# Format: 123456:ABCDEFghijklmnopqrstuvwxyz
export TELEGRAM_TOKEN="123456:ABCDEFghijklmnopqrstuvwxyz"

# Telegram Chat ID (required)
# Your personal Telegram user ID for receiving bot messages
# Get from: https://api.telegram.org/botTOKEN/getUpdates
# (After sending a message to your bot, check the "id" field in "from")
export TELEGRAM_CHAT="9876543210"

# Admin password (optional)
# If not set, will be auto-generated
# Must be strong for production use
# Example: "P@ssw0rd!2024#Secure"
export ADMIN_PASS="YourSecurePasswordHere123!"

# Repository source path (optional)
# Defaults to current directory (.)
# Set if cloning from elsewhere
# export REPO_SOURCE="~/authflow"

# Application port (optional)
# Defaults to 8080
# Must not conflict with other services
# export APP_PORT="8080"

# ============================================================================
# Usage Instructions
# ============================================================================
#
# 1. Copy this template:
#    cp scripts/.env.template scripts/.env.production
#
# 2. Edit with your values:
#    nano scripts/.env.production
#
# 3. Source the environment:
#    source scripts/.env.production
#
# 4. Verify values:
#    echo "Domain: $DOMAIN"
#    echo "VPS IP: $VPS_IP"
#    echo "Cloudflare Token: ${CLOUDFLARE_TOKEN:0:10}..."
#    echo "Telegram Bot Token: ${TELEGRAM_TOKEN:0:10}..."
#    echo "Telegram Chat ID: $TELEGRAM_CHAT"
#
# 5. Run installer with environment variables preserved:
#    sudo -E ./scripts/install-prod.sh
#
# ============================================================================
# Environment Variable Reference
# ============================================================================
#
# DOMAIN
#   Your primary domain name
#   Used for TLS certificates and nginx configuration
#   Format: example.com (without https:// or trailing /)
#   Required: Yes
#
# VPS_IP
#   Your server's public IPv4 address
#   Used in DNS A records and configuration
#   Format: 203.0.113.42 (IPv4 address)
#   Required: Yes
#
# CLOUDFLARE_TOKEN
#   API token for Cloudflare DNS operations
#   Used for automatic TLS certificate renewal
#   Security: Keep this secret! Never commit to git.
#   How to get:
#     1. Log in to https://dash.cloudflare.com/
#     2. Go to Account Settings > API Tokens
#     3. Click "Create Token"
#     4. Select "Edit zone DNS" template
#     5. Configure permissions for your zone
#     6. Copy the token
#   Required: Yes
#
# TELEGRAM_TOKEN
#   Bot token from @BotFather
#   Used to send alerts and notifications
#   Format: 123456:ABCDEFghijklmnopqrstuvwxyz
#   How to get:
#     1. Find @BotFather on Telegram
#     2. Send /start
#     3. Send /newbot
#     4. Follow prompts, receive token
#   Security: Keep this secret! Never commit to git.
#   Required: Yes
#
# TELEGRAM_CHAT
#   Your personal Telegram user ID
#   Where the bot will send messages
#   Format: Numeric ID (e.g., 9876543210)
#   How to get:
#     1. Send a message to your bot
#     2. Visit: https://api.telegram.org/botTOKEN/getUpdates
#     3. Look for "from" → "id" field
#   Required: Yes
#
# ADMIN_PASS
#   Dashboard administrator password
#   Used to log into the web interface
#   Format: Any strong password (20+ chars recommended)
#   If not provided: Will be auto-generated (24-char random)
#   Security: Store securely in password manager
#   Required: No (auto-generated if omitted)
#
# REPO_SOURCE
#   Path to AuthFlow repository source
#   Used when cloning from non-standard location
#   Format: /path/to/authflow or ~/authflow
#   Default: Current directory (.)
#   Required: No
#
# APP_PORT
#   Internal application port
#   Where Go app listens (behind nginx proxy)
#   Format: Numeric port (e.g., 8080)
#   Default: 8080
#   Must not conflict with other services
#   Required: No
#
# ============================================================================
# Security Notes
# ============================================================================
#
# 1. Store .env.production securely
#    chmod 600 scripts/.env.production
#    Do not commit to git
#
# 2. Rotate credentials periodically
#    - Cloudflare token: Every 90 days
#    - Admin password: Every 60 days
#    - Telegram bot: If compromised
#
# 3. Use strong passwords
#    Recommended: 20+ characters, mixed case, numbers, symbols
#    Tools: openssl rand -base64 20, pwgen, 1password, bitwarden
#
# 4. Keep installer script updated
#    git pull origin main
#    Review install-prod.sh for changes
#
# 5. Monitor access logs
#    tail -f /var/log/nginx/authflow_access.log
#    journalctl -u authflow -f
#
# ============================================================================
# Example Configuration
# ============================================================================
#
# export DOMAIN="mycompany.com"
# export VPS_IP="198.51.100.5"
# export CLOUDFLARE_TOKEN="cfut_abcdef1234567890abcdef1234567890"
# export TELEGRAM_TOKEN="987654:XYZ1234567890abcdefghijklmnopqrst"
# export TELEGRAM_CHAT="1122334455"
# export ADMIN_PASS="MyStr0ng!P@ssw0rd2024"
#
# Then run:
# sudo -E ./scripts/install-prod.sh
#
# ============================================================================
